#
# Unisoc UMS9230 Performance & Turbo Boost Properties
#

# Enable Unisoc BSP Game Boost
persist.sys.unisoc_game_boost=true
sys.perf.boost=1
ro.vendor.gpu.boost=1

# Power & Touch Response
persist.sys.power.touch=1
persist.sys.heartbeat.enable=0
persist.sys.pwctl.enable=0
persist.sys.pwctl.guru=0
persist.sys.pwctl.appidle=0
persist.sys.pwctl.appidle.force=0
persist.sys.pwctl.onlysave=0
persist.sys.pwctl.bgclean=0

# Disable Userspace Thermal Throttling Daemons
vendor.thermal.enable=0
persist.vendor.thermal.engine=0
ro.vendor.power.thermal.enable=0

# Rendering and Frame Pacing
ro.surface_flinger.game_default_frame_rate_override=60
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
